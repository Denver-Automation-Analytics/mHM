{
  "name": "mHM Linux Dev Environment",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
  "customizations": {
    "vscode": {
      "extensions": [
        "fortran-lang.linter-gfortran",
        "ekibun.fortranbreaker",
        "ms-vscode.cmake-tools",
        "twxs.cmake",
        "ms-python.python"
      ],
      "settings": {
        "cmake.configureOnOpen": true,
        "cmake.generator": "Ninja",
        "cmake.buildDirectory": "${workspaceFolder}/build",
        "cmake.configureArgs": ["-DCMAKE_WITH_OpenMP=ON"],
        "fortran.linter.compiler": "gfortran",
        "fortran.linter.compilerPath": "/opt/conda/envs/mhm-dev/bin/gfortran"
      }
    }
  },
  "remoteEnv": {
    "PATH": "/opt/conda/envs/mhm-dev/bin:${containerEnv:PATH}",
    "CMAKE_PREFIX_PATH": "/opt/conda/envs/mhm-dev"
  },
  "postCreateCommand": "echo 'mHM dev container ready. Conda env: .devcontainer/env.yaml. Build with: cmake -S . -B build -G Ninja -DCMAKE_WITH_OpenMP=ON && cmake --build build'"
}
